<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BokuNoKanji.Views.SearchPage"
             Title="Search Kanji"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#171717}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="BokuNoKanji"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>

                <Label Text="Your personal Japanese character dictionary"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
            </VerticalStackLayout>

            <!-- Search -->
            <Border Padding="8"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                    Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    StrokeShape="RoundRectangle 16">

                <SearchBar x:Name="KanjiSearchBar"
                           Placeholder="Search kanji, meaning, or strokes..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SearchButtonPressed="SearchBar_SearchButtonPressed"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#C74735"
                           TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>
            </Border>

            <!-- Search tips -->
            <Border
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#F4EAE2, Dark=#302722}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="9">
                    <Label Text="QUICK SEARCH GUIDE"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#A53E30, Dark=#F0A08D}"/>

                    <Label Text="人  —  Search by character"
                           FontSize="14"/>

                    <Label Text="person  —  Search by meaning"
                           FontSize="14"/>

                    <Label Text="2  —  Search by stroke count"
                           FontSize="14"/>

                    <Label Text="Leave the search empty to explore random kanji."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Display settings -->
            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                    Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    StrokeShape="RoundRectangle 14">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="Results limit"
                               FontSize="15"
                               FontAttributes="Bold"/>

                        <Label Text="Choose how many kanji to display"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
                    </VerticalStackLayout>

                    <Picker x:Name="picker"
                            Grid.Column="1"
                            WidthRequest="135"
                            VerticalOptions="Center"
                            SelectedIndex="{Binding SelectedLimitIndex, Mode=TwoWay}">

                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>50 results</x:String>
                                <x:String>100 results</x:String>
                                <x:String>200 results</x:String>
                                <x:String>500 results</x:String>
                                <x:String>All results</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Grid>
            </Border>

            <!-- Advanced search toggle -->
            <Border Padding="14,10"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                    Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    StrokeShape="RoundRectangle 14">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">

                    <CheckBox IsChecked="False"
                              VerticalOptions="Center"
                              Color="#C74735"
                              CheckedChanged="CheckBox_CheckedChanged"/>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Advanced search"
                               FontSize="15"
                               FontAttributes="Bold"/>

                        <Label Text="Combine conditions to refine results"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            x:Name="HelpButton"
                            Text="?"
                            FontSize="14"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            CornerRadius="18"
                            BackgroundColor="{AppThemeBinding Light=#F4EAE2, Dark=#302722}"
                            TextColor="{AppThemeBinding Light=#A53E30, Dark=#F0A08D}"
                            Clicked="HelpButton_Clicked"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Advanced search panel -->
            <VerticalStackLayout x:Name="AdvancedSearchSub"
                                 IsVisible="False"
                                 Spacing="14">

                <Label Text="Search conditions"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <Border Padding="10"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                        StrokeShape="RoundRectangle 14">

                    <CollectionView
                        ItemsSource="{Binding Source={x:Reference AdvancedSearchSub}, Path=BindingContext.Conditions}"
                        HeightRequest="300"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      Padding="6"
                                      ColumnSpacing="8"
                                      RowSpacing="8">

                                    <!-- Field -->
                                    <Picker Grid.Row="0"
                                            Grid.Column="0"
                                            Title="Field"
                                            x:Name="FieldPicker"
                                            ItemsSource="{Binding Source={x:Reference AdvancedSearchSub}, Path=BindingContext.AvailableFields}"
                                            SelectedItem="{Binding Field}"
                                            VerticalOptions="Center"/>

                                    <!-- Operator -->
                                    <Picker Grid.Row="0"
                                            Grid.Column="1"
                                            Title="Operator"
                                            x:Name="OperatorPicker"
                                            ItemsSource="{Binding Source={x:Reference AdvancedSearchSub}, Path=BindingContext.AvailableOperators}"
                                            SelectedItem="{Binding Operator}"
                                            VerticalOptions="Center"/>

                                    <!-- Remove -->
                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Text="×"
                                            FontSize="22"
                                            Padding="0"
                                            WidthRequest="38"
                                            HeightRequest="76"
                                            CornerRadius="10"
                                            BackgroundColor="{AppThemeBinding Light=#FBE9E6, Dark=#402724}"
                                            TextColor="{AppThemeBinding Light=#B63C30, Dark=#F0A08D}"
                                            Command="{Binding Source={x:Reference AdvancedSearchSub}, Path=BindingContext.RemoveConditionCommand}"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center"/>

                                    <!-- Value -->
                                    <Entry Grid.Row="1"
                                           Grid.Column="0"
                                           Placeholder="Value"
                                           Text="{Binding Value}"
                                           VerticalOptions="Center"/>

                                    <!-- Logical operator -->
                                    <Picker Grid.Row="1"
                                            Grid.Column="1"
                                            Title="Logic"
                                            ItemsSource="{Binding Source={x:Reference AdvancedSearchSub}, Path=BindingContext.AvailableLogical}"
                                            SelectedItem="{Binding Logical}"
                                            VerticalOptions="Center"/>

                                    <BoxView Grid.Row="2"
                                             Grid.ColumnSpan="3"
                                             HeightRequest="1"
                                             BackgroundColor="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                                             Margin="0,8"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- Actions -->
                <Button Text="+  Add condition"
                        Command="{Binding AddConditionCommand}"
                        BackgroundColor="{AppThemeBinding Light=#F0E5DB, Dark=#302722}"
                        TextColor="{AppThemeBinding Light=#8F392D, Dark=#F0A08D}"
                        CornerRadius="12"
                        HeightRequest="48"/>

                <Button Text="Search kanji"
                        Command="{Binding ExecuteSearchCommand}"
                        BackgroundColor="#B94332"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>