<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BokuNoKanji.Views.KanjiListPage"
             Title="Kanji Results"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#171717}">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="24,20"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="16"
              BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#171717}">

            <Button Grid.Column="0"
                    Text="←  Back"
                    Clicked="BackButton_Clicked"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#F0E5DB, Dark=#302722}"
                    TextColor="{AppThemeBinding Light=#8F392D, Dark=#F0A08D}"
                    CornerRadius="12"
                    Padding="14,10"/>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">

                <Label Text="Kanji Library"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>

                <Label Text="{Binding DisplayedKanji.Count, StringFormat='{0} characters found'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="Clear"
                    Clicked="ClearButton_Clicked"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#B94332, Dark=#F0A08D}"
                    BorderColor="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    BorderWidth="1"
                    CornerRadius="12"
                    Padding="16,10"/>
        </Grid>

        <!-- Kanji gallery -->
        <CollectionView Grid.Row="1"
                        x:Name="KanjiCollection"
                        ItemsSource="{Binding DisplayedKanji}"
                        SelectionMode="Single"
                        SelectionChanged="OnKanjiSelected"
                        Margin="16,4,16,20">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="4"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            MinimumHeightRequest="112"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                            Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="5"
                                             HorizontalOptions="Fill"
                                             VerticalOptions="Center">

                            <Label Text="{Binding Character}"
                                   FontSize="42"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#292522, Dark=#F5F1EA}"
                                   FontFamily=""/>

                            <BoxView HeightRequest="2"
                                     WidthRequest="24"
                                     CornerRadius="1"
                                     HorizontalOptions="Center"
                                     BackgroundColor="#C74735"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty state -->
            <CollectionView.EmptyView>
                <Grid Padding="24"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">

                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MaximumWidthRequest="360">

                        <Border WidthRequest="100"
                                HeightRequest="100"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#F4EAE2, Dark=#302722}"
                                StrokeShape="RoundRectangle 28"
                                HorizontalOptions="Center">

                            <Label Text="漢"
                                   FontSize="52"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#B94332, Dark=#F0A08D}"/>
                        </Border>

                        <Label Text="No kanji found"
                               FontSize="23"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>

                        <Label Text="We couldn't find any characters matching your search. Try another word, reading, or stroke count."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>

                        <Button Text="Back to Search"
                                Clicked="BackButton_Clicked"
                                Margin="0,12,0,0"
                                HorizontalOptions="Center"
                                BackgroundColor="#B94332"
                                TextColor="White"
                                CornerRadius="12"
                                Padding="20,12"/>
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>