<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BokuNoKanji.Views.SearchPage"
             Title="Search Kanji"
             BackgroundColor="{AppThemeBinding Light=#FAF8F4, Dark=#171717}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="BokuNoKanji"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>

                <Label Text="Your personal Japanese character dictionary"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
            </VerticalStackLayout>

            <!-- Search -->
            <Border Padding="8"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                    Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    StrokeShape="RoundRectangle 16">

                <SearchBar x:Name="KanjiSearchBar"
                           Placeholder="Search kanji, meaning, or strokes..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SearchButtonPressed="SearchBar_SearchButtonPressed"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#C74735"
                           TextColor="{AppThemeBinding Light=#252525, Dark=#F5F1EA}"/>
            </Border>

            <!-- Search tips -->
            <Border x:Name="TipsBorder"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#F4EAE2, Dark=#302722}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="9">
                    <Label Text="QUICK SEARCH GUIDE"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#A53E30, Dark=#F0A08D}"/>

                    <Label Text="人  —  Search by character"
                           FontSize="14"/>

                    <Label Text="person  —  Search by meaning"
                           FontSize="14"/>

                    <Label Text="2  —  Search by stroke count"
                           FontSize="14"/>

                    <Label Text="Leave the search empty to explore random kanji."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Display settings -->
            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                    Stroke="{AppThemeBinding Light=#E7E1D9, Dark=#3B3B3B}"
                    StrokeShape="RoundRectangle 14">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="Results limit"
                               FontSize="15"
                               FontAttributes="Bold"/>

                        <Label Text="Choose how many kanji to display"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#77716A, Dark=#B8B2AA}"/>
                    </VerticalStackLayout>

                    <Picker x:Name="picker"
                            Grid.Column="1"
                            WidthRequest="135"
                            VerticalOptions="Center"
                            SelectedIndex="{Binding SelectedLimitIndex, Mode=TwoWay}">

                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>50 results</x:String>
                                <x:String>100 results</x:String>
                                <x:String>200 results</x:String>
                                <x:String>500 results</x:String>
                                <x:String>All results</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Grid>
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>